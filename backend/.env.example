GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Set true only after checking this key's project is on the free tier, with no paid billing.
GEMINI_FREE_TIER_CONFIRMED=false
# Explicit, optional local source-reading mode: extractive. Never an automatic API-error fallback.
ANSWER_MODE=gemini
ADMIN_API_KEY=
CORS_ORIGINS=["http://localhost:3000"]
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# onnx uses the SAME model and normalized mean pooling without loading torch.
EMBEDDING_BACKEND=onnx
RATE_LIMIT_PER_MINUTE=12
GLOBAL_GENERATION_PER_DAY=150
SERVE_FRONTEND=true
